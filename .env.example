# ==============================================================================
# GravityCRM — Environment Variables Template
# ==============================================================================

# Supabase Public Configuration (Accessible on Client & Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Supabase Server-Only Secret (NEVER expose to frontend bundle)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# Telegram Bot Integration (Used exclusively in Edge Functions / Server Handlers)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_token_123456

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
